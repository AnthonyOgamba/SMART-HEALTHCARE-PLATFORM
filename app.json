{
  "expo": {
    "name": "Genie Cares",
    "slug": "smart-healthcare-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/genie_app_image.png",
    "scheme": "smarthealthcaremobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/genie_app_image.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/alarm-clock-digital-beeping.wav",
            "./assets/sounds/air-raid-siren-wailing-urgent.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/genie_app_image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5FAFD",
          "dark": {
            "image": "./assets/images/genie_app_image.png",
            "backgroundColor": "#F5FAFD"
          }
        }
      ]
    ],
    "extra": {
      "bundledMedicationReminderSounds": [
        "alarm-clock-digital-beeping.wav",
        "air-raid-siren-wailing-urgent.wav"
      ]
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
